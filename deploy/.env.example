# /volume1/docker/projects/personal-website/.env — copy this file there and
# fill it in. chmod 600; it never goes in the repo or the image.

# From the Vercel project's environment variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAWG_API_KEY=

# Zero Trust → Networks → Tunnels → nas-site → the token in the install command.
TUNNEL_TOKEN=

# auto (QUIC, falling back to HTTP/2) or http2.
TUNNEL_PROTOCOL=auto

# The image tag (a main commit) that is serving. deploy.sh writes it after
# each successful deploy; leave it empty before the first one.
SITE_SHA=
