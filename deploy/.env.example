# /volume1/docker/projects/personal-website/.env — copy this file there and
# fill it in. chmod 600; it never goes in the repo or the image.

# From the Vercel project's environment variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAWG_API_KEY=

# Zero Trust → Networks → Tunnels → nas-site → the token in the install command.
TUNNEL_TOKEN=

# auto (QUIC, falling back to HTTP/2) or http2.
TUNNEL_PROTOCOL=auto

# The image tag (a main commit) that is serving. deploy.sh writes it after
# each successful deploy; leave it empty before the first one.
SITE_SHA=

# --- Optional. A live project needs none of these; staging's are in docs/staging.md.
# STACK=personal-website        compose project and image name
# DEPLOY_BRANCH=main
# IMAGE_BACKEND=cloudinary      or nas
# PHOTO_INDEX_DIR=./photos/index
# PHOTOS=1                      run img and photos here (one project only)
# PHOTOS_USER=1026:100          uid:gid that owns Published
# PUBLISH_ALBUMS=1              commit album files (needs GITHUB_TOKEN)
# GITHUB_TOKEN=
# PHOTOS_API_SECRET=            32+ random characters
# CMS_BRANCH=main               run cms-dashboard here
# DRAFTS_BRANCH=drafts
# CMS_AUTH_USER_HASH='$2b$...'  single quotes: the hash has $ signs
# CMS_AUTH_PASSWORD_HASH='$2b$...'
# CMS_SESSION_SECRET=           32+ random characters
#
# deploy.sh writes these.
# PHOTOS_SHA=
# CMS_SHA=
