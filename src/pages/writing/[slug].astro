---
import { render } from "astro:content";
import WriteupLayout from "../../layouts/WriteupLayout.astro";
import { mdxComponents } from "../../components/writeup/index";
import { writeupPaths } from "../../lib/content";
import { tocFromBody } from "../../lib/toc";

export async function getStaticPaths() {
  return writeupPaths("writing");
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const toc = tocFromBody(entry.body);
---

<WriteupLayout entry={entry} toc={toc}>
  <Content components={mdxComponents} />
</WriteupLayout>
