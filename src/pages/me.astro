---
/**
 * /me (Figma Subpage / Me 28:940). Static copy from v2 ui/Background.astro.
 * Portrait is a Cloudinary slot (site/me/portrait).
 */
import SubpageLayout from "../layouts/SubpageLayout.astro";
import CldImage from "../components/media/CldImage.astro";
import Icon from "../components/icons/Icon.astro";
import Mark from "../components/chrome/Mark.astro";
import Journey from "../components/chrome/Journey.astro";
---

<SubpageLayout title="Me - Liam Sullivan" section="me">
  <div
    class="flex w-full flex-col items-center gap-8 overflow-clip px-6 py-6 md:flex-row md:items-start md:justify-center md:gap-16 md:px-16 md:py-12"
    data-name="Content"
  >
    <div class="relative aspect-[4/5] w-full max-w-[400px] shrink-0 overflow-clip rounded-md bg-skeleton md:h-[500px] md:w-[400px]" data-name="portrait">
      <CldImage id="site/me/portrait" alt="Liam Sullivan" aspect="4:5" gravity="face" fill sizes="(min-width: 768px) 400px, 100vw" loading="eager" fetchpriority="high" />
    </div>

    <div class="flex w-full max-w-[680px] min-w-0 flex-col items-start gap-6" data-name="Prose">
      <div class="flex items-center gap-[14px]" data-name="heading">
        <h1 class="m-0 text-[40px] leading-[1.1] font-bold text-walnut md:text-[56px]">Liam Sullivan</h1>
        <span class="flex items-center p-[2px] text-walnut" aria-hidden="true">
          <Icon name="user" class="me-heading-icon" />
        </span>
      </div>

      <p class="me-prose">
        I’ve been restless since the day I was born.
      </p>
      <p class="me-prose">
        At 10, I created my first <Mark
          href="https://www.youtube.com/@liambsulliva"
          color="#FF3D3D"
          icon="youtube"
        >YouTube channel</Mark>. At 12, I experimented with claymaking. 13 saw me begin my foray into <Mark
          href="/photography"
          color="var(--accent-photography)"
          icon="camera"
        >photography</Mark>, mainly portraiture, which I still do to this day.
      </p>
      <p class="me-prose">
        Moving from <Journey from="Virginia" to="Pittsburgh" time="4h drive" distance="250 mi" /> changed me. I joined a fraternity, pivoted into <Mark
          href="/career"
          color="var(--accent-career)"
          icon="briefcase"
        >journalism</Mark>, and found a passion for the technical artistry afforded by <Mark
          href="/engineering"
          color="var(--accent-engineering)"
          icon="monitor"
        >web development</Mark>. Heading the <Mark
          href="/design"
          color="var(--accent-design)"
          icon="palette"
        >design club</Mark> at my university introduced a visual bent into my engineering work.
      </p>
      <p class="me-prose">
        Today, I’m redesigning <Mark href="https://www.pnc.com" color="var(--accent-pnc)" image="/brand/pnc.png">PNC.com</Mark>, but I also like to <Mark href="/writing" color="var(--accent-writing)" icon="pen">cook and write</Mark>.
      </p>
      <p class="me-prose">
        This is my virtual museum. Take a look around, maybe you’ll find something you appreciate.
      </p>
    </div>
  </div>
</SubpageLayout>

<style>
  /* The user glyph matches the heading: 24px on mobile, text-sized on desktop. */
  @media (min-width: 768px) {
    :global(.me-heading-icon) {
      width: 48px !important;
      height: 48px !important;
    }
  }
  /* Figma p1–p3: 18px Geist, 18px line boxes wrapped with an 8px row gap. */
  .me-prose {
    margin: 0;
    width: 100%;
    font-size: 18px;
    line-height: 26px;
    color: var(--fg);
  }
</style>
