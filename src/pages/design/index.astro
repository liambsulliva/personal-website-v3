---
/**
 * /design (Figma Subpage / Design 53:3354): the featured case study or piece as a
 * FeaturedArticle, any other case studies (also FeaturedArticle), then
 * Graphic Design (3-up), Layouts (2-up), Design Club (3-up) ArticleCards.
 */
import SubpageLayout from "../../layouts/SubpageLayout.astro";
import ArticleCard from "../../components/cards/ArticleCard.astro";
import FeaturedArticle from "../../components/cards/FeaturedArticle.astro";
import SectionLabel from "../../components/cards/SectionLabel.astro";
import { getPieces, getProjects, hasWriteup, pieceMeta, projectHref, splitFeatured } from "../../lib/content";
import type { CollectionEntry } from "astro:content";

// Either a case study or a piece can lead the page; case studies win a tie.
const { featured: featuredProject, rest: caseStudies } = splitFeatured(await getProjects("design"));
const allPieces = await getPieces("design");
const pieceSplit = splitFeatured(allPieces);
const featuredPiece = featuredProject ? undefined : pieceSplit.featured;
const pieces = featuredPiece ? pieceSplit.rest : allPieces;

const caseStudyCard = (project: CollectionEntry<"projects">) => ({
  title: project.data.title,
  description: project.data.description,
  meta: project.data.date ? pieceMeta("Case Study", project.data.date) : "Case Study",
  image: project.data.image,
  href: projectHref(project),
  external: !hasWriteup(project),
  bare: true,
});
const featured = featuredProject
  ? caseStudyCard(featuredProject)
  : featuredPiece && {
      title: featuredPiece.data.title,
      description: featuredPiece.data.description,
      meta: pieceMeta(featuredPiece.data.kind, featuredPiece.data.date),
      image: featuredPiece.data.image,
      href: featuredPiece.data.href,
      external: featuredPiece.data.external,
      bare: false,
    };
const sections = [
  { key: "graphic-design", label: "Graphic Design", columns: 3 },
  { key: "layouts", label: "Layouts", columns: 2, media: "wide" },
  { key: "design-club", label: "Design Club", columns: 3 },
] as const;
---

<SubpageLayout title="Design - Liam Sullivan" section="design">
  <div class="flex w-full flex-col items-start gap-12 overflow-clip px-6 py-6 md:px-16 md:py-12" data-name="DesignBody">
    {
      featured && (
        <section class="flex w-full flex-col items-start gap-3" aria-labelledby="design-featured">
          <SectionLabel id="design-featured" eyebrow>Featured!</SectionLabel>
          <FeaturedArticle {...featured} />
        </section>
      )
    }
    {
      caseStudies.length > 0 && (
        <section class="flex w-full flex-col items-start gap-3" aria-labelledby="design-case-studies">
          <SectionLabel id="design-case-studies">Case Studies</SectionLabel>
          {caseStudies.map((project) => (
            <FeaturedArticle {...caseStudyCard(project)} />
          ))}
        </section>
      )
    }
    {
      sections.map((section) => {
        const items = pieces.filter((piece) => piece.data.section === section.key);
        if (items.length === 0) return null;
        return (
          <section class="flex w-full flex-col items-start gap-3" aria-labelledby={`design-${section.key}`}>
            <SectionLabel id={`design-${section.key}`}>{section.label}</SectionLabel>
            <div class:list={["grid w-full grid-cols-1 gap-x-6 gap-y-3", section.columns === 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2"]}>
              {items.map(({ data }) => (
                <ArticleCard
                  title={data.title}
                  meta={pieceMeta(data.kind, data.date)}
                  href={data.href}
                  image={data.image}
                  external={data.external}
                  media={"media" in section ? section.media : undefined}
                />
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</SubpageLayout>
