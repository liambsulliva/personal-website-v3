---
/**
 * /writing (Figma Subpage / Writing 28:811). Featured (SectionLabel +
 * FeaturedArticle), then Substack / Video Essays / Cooking (from `pieces`,
 * hidden while empty) and Study Abroad (Berlin WordPress posts, SSR fetch,
 * 300s cache).
 */
import SubpageLayout from "../layouts/SubpageLayout.astro";
import ArticleCard from "../components/cards/ArticleCard.astro";
import FeaturedArticle from "../components/cards/FeaturedArticle.astro";
import SectionLabel from "../components/cards/SectionLabel.astro";
import { getPieces, pieceMeta } from "../lib/content";
import { getBerlinPosts } from "../lib/berlin";
import { PUBLIC_CACHE_CONTROL } from "../lib/cloudinaryServer";

export const prerender = false;

Astro.response.headers.set("Cache-Control", PUBLIC_CACHE_CONTROL);

const [pieces, berlin] = await Promise.all([getPieces("writing"), getBerlinPosts()]);
const featured = pieces.find((piece) => piece.data.section === "featured");
const sections = [
  { key: "substack", label: "Substack" },
  { key: "video", label: "Video Essays" },
  { key: "cooking", label: "Cooking" },
] as const;
---

<SubpageLayout title="Writing - Liam Sullivan" section="writing">
  <div class="flex w-full flex-col items-start gap-12 overflow-clip px-6 py-6 md:px-16 md:py-12" data-name="WritingBody">
    {
      featured && (
        <section class="flex w-full flex-col items-start gap-3" aria-labelledby="writing-featured">
          <SectionLabel id="writing-featured" eyebrow>Featured!</SectionLabel>
          <FeaturedArticle
            title={featured.data.title}
            description={featured.data.description}
            meta={pieceMeta(featured.data.kind, featured.data.date, true)}
            href={featured.data.href}
            image={featured.data.image}
          />
        </section>
      )
    }
    {
      sections.map((section) => {
        const items = pieces.filter((piece) => piece.data.section === section.key);
        if (items.length === 0) return null;
        return (
          <section class="flex w-full flex-col items-start gap-3" aria-labelledby={`writing-${section.key}`}>
            <SectionLabel id={`writing-${section.key}`}>{section.label}</SectionLabel>
            <div class="grid w-full grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
              {items.map(({ data }) => (
                <ArticleCard title={data.title} meta={pieceMeta(data.kind, data.date)} href={data.href} image={data.image} external={data.external} />
              ))}
            </div>
          </section>
        );
      })
    }
    {
      berlin.length > 0 && (
        <section class="flex w-full flex-col items-start gap-3" aria-labelledby="writing-berlin">
          <SectionLabel id="writing-berlin">Study Abroad</SectionLabel>
          <div class="grid w-full grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
            {berlin.map((post) => (
              <ArticleCard title={post.title} meta={pieceMeta("Blog", post.date)} href={post.href} imageUrl={post.image} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</SubpageLayout>
