---
/**
 * /photography (Figma Subpage / Photography / Albums 190:3925). SSR: the album
 * stacks (src/data/albums.ts, no Cloudinary call), the tag list, and the first
 * masonry page. One island holds the stacks and the gallery, since opening an
 * album fills the gallery; it starts above the fold, so it hydrates on load.
 */
import SubpageLayout from "../layouts/SubpageLayout.astro";
import PhotoGallery from "../components/islands/PhotoGallery.tsx";
import { ALBUMS } from "../data/albums";
import { toAlbumCard } from "../lib/albums";
import { listPhotoTags, photoExpression, PUBLIC_CACHE_CONTROL, searchPhotos } from "../lib/cloudinaryServer";
import { toGalleryPhoto } from "../lib/photos";

export const prerender = false;

Astro.response.headers.set("Cache-Control", PUBLIC_CACHE_CONTROL);

const [firstPage, tags] = await Promise.all([
  searchPhotos({ expression: photoExpression(), max_results: 20 }),
  listPhotoTags(),
]);

const albums = ALBUMS.map(toAlbumCard);
const photos = firstPage.data.resources.map(toGalleryPhoto);
---

<SubpageLayout title="Photography - Liam Sullivan" section="photography">
  <div class="flex w-full min-w-0 flex-col items-stretch gap-8 overflow-x-clip px-6 py-6 md:px-16 md:py-12" data-name="Content">
    <PhotoGallery
      client:load
      albums={albums}
      tags={tags}
      initialPhotos={photos}
      initialCursor={firstPage.data.next_cursor ?? null}
    />
  </div>
</SubpageLayout>
