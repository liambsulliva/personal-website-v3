---
/**
 * Monochrome Figma glyph (./svg/*.svg) inlined in currentColor so it follows
 * theme + accent tokens without editing the asset, and paints with the page
 * (no image request to blank it during navigation).
 */
import type { HTMLAttributes } from "astro/types";
import { glyph } from "../../lib/glyph";

interface Props extends HTMLAttributes<"svg"> {
  name: string;
  size?: number | string;
  class?: string;
  style?: string;
}

const sources = import.meta.glob<string>("./svg/*.svg", { query: "?raw", import: "default", eager: true });

const { name, size = 24, class: className, style = "", ...rest } = Astro.props;
const source = sources[`./svg/${name}.svg`];
if (!source) throw new Error(`Icon: no glyph named "${name}"`);
const { viewBox, body } = glyph(source);
const dimension = typeof size === "number" ? `${size}px` : size;
---

<svg
  class:list={["glyph", className]}
  viewBox={viewBox}
  fill="none"
  preserveAspectRatio="none"
  style={`width:${dimension};height:${dimension};${style}`}
  data-icon={name}
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={body}
/>
