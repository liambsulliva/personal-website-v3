---
/** IconButton zap / zap-off. Zap-off = reduced JS + no decorative motion. */
import IconButton from "./IconButton.astro";
import Icon from "../icons/Icon.astro";
---

<IconButton label="Toggle motion" action="motion">
  <Fragment slot="icon">
    <Icon name="zap" class="motion-glyph" data-for="on" />
    <Icon name="zap-off" class="motion-glyph" data-for="off" />
  </Fragment>
  <Fragment slot="label">
    <span class="motion-label" data-for="on">Motion on</span>
    <span class="motion-label" data-for="off">Motion off</span>
  </Fragment>
</IconButton>

<style is:global>
  :root[data-reduced-motion] .motion-glyph[data-for="on"],
  :root:not([data-reduced-motion]) .motion-glyph[data-for="off"],
  :root[data-reduced-motion] .motion-label[data-for="on"],
  :root:not([data-reduced-motion]) .motion-label[data-for="off"] {
    display: none;
  }

  /* Press scale is a transform, so zap's `transition: none` still leaves an
     instant shrink. Lives here (not global.css) so Tailwind/Lightning CSS
     cannot flatten or drop the override. */
  :root[data-reduced-motion] .squishy:not(:disabled):active,
  :root[data-reduced-motion] .yarl__button:not(:disabled):active,
  :root[data-reduced-motion] .logomark__summary:active,
  :root[data-reduced-motion] .version-option:active {
    transform: none;
  }
  :root[data-reduced-motion] .yarl__navigation_prev:not(:disabled):active {
    transform: translateY(-50%);
  }
  :root[data-reduced-motion] .yarl__navigation_next:not(:disabled):active {
    transform: translateY(-50%);
  }
  :root[data-reduced-motion] [dir="rtl"] .yarl__navigation_prev:not(:disabled):active,
  :root[data-reduced-motion][dir="rtl"] .yarl__navigation_prev:not(:disabled):active,
  :root[data-reduced-motion] [dir="rtl"] .yarl__navigation_next:not(:disabled):active,
  :root[data-reduced-motion][dir="rtl"] .yarl__navigation_next:not(:disabled):active {
    transform: translateY(-50%) rotate(180deg);
  }
</style>
