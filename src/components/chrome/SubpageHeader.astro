---
/**
 * Figma SubpageHeader (21:448): the bar ("Liam Sullivan" breadcrumb +
 * compact-nav). The title row lives in <main> (PageTitle). Below md the
 * compact-nav collapses into the MobileMenu popover.
 */
import CompactNavIcon from "./CompactNavIcon.astro";
import IconButton from "./IconButton.astro";
import MobileMenu from "./MobileMenu.astro";
import Breadcrumb from "./Breadcrumb.astro";
import { SECTIONS, type SectionKey } from "../../lib/sections";

interface Props {
  section?: SectionKey;
  /** A PageTitle follows and brings its own top spacing */
  titled?: boolean;
}

const { section, titled = false } = Astro.props;
---

<header
  class:list={["flex w-full flex-col items-start px-6 pt-4 md:px-16 md:pt-8", { "pb-6 md:pb-8": !titled }]}
  data-name="Header"
>
  <div class="flex w-full items-center justify-between gap-4" data-name="bar">
    <!-- Section pages mirror their URL; section-less pages (404) show the name alone. -->
    <Breadcrumb path={section ? Astro.url.pathname : undefined} />
    <nav class="hidden items-start md:flex" aria-label="Sections" data-name="compact-nav">
      {
        SECTIONS.map((item) => (
          <CompactNavIcon section={item} current={item.key === section} />
        ))
      }
    </nav>
    <IconButton
      class="md:hidden"
      icon="menu"
      label="Menu"
      attrs={{ popovertarget: "mobile-menu" }}
    />
  </div>
</header>

<MobileMenu />
