---
/**
 * Inline accent chip from Figma /me (mark/*): semibold accent word(s) with a
 * 16px glyph in a padded slot. Links to the v2 reference. Long titles (DNID)
 * wrap with the prose instead of clipping on narrow screens; the glyph rides
 * the last line.
 */
import Icon from "../icons/Icon.astro";

interface Props {
  href: string;
  color: string;
  icon?: string;
  image?: string;
}

const { href, color, icon, image } = Astro.props;
---

<style>
  /* inline-block + max-width so short marks stay in the line and long ones
     wrap inside the prose column. No fixed height: wrapped lines must stack. */
  .mark {
    display: inline-block;
    max-width: 100%;
    vertical-align: baseline;
  }
  .mark__glyph {
    display: inline-flex;
    margin-left: 0.25rem;
    padding: 2px;
    vertical-align: text-bottom;
  }
  @media (hover: hover) {
    .mark:hover .mark__text {
      text-decoration: underline;
      text-decoration-thickness: from-font;
      text-underline-position: from-font;
    }
  }
</style>

<a href={href} target="_blank" rel="noopener noreferrer" class="mark squishy squishy-md font-semibold no-underline" style={`color:${color}`}
  ><span class="mark__text"><slot /></span>{
    icon && (
      <span class="mark__glyph" aria-hidden="true">
        <Icon name={icon} size={16} />
      </span>
    )
  }{
    image && (
      <span class="mark__glyph" aria-hidden="true">
        <img src={image} alt="" width="16" height="16" class="size-4 object-contain" />
      </span>
    )
  }</a
>
