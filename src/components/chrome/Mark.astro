---
/**
 * Inline accent chip from Figma /me (mark/*): semibold accent word(s) with a
 * 16px glyph in a padded slot. External links open in a new tab; site paths
 * stay in-tab. The link is a plain inline run, so long titles (DNID) break
 * mid-sentence like the rest of the paragraph; the last word and glyph stay
 * together so the glyph never starts a line on its own.
 *
 * The glyph plays its move (icons/MotionIcon.astro; an image logo flips over
 * like a coin) on hover, or on touch screens once it comes into view.
 */
import MotionIcon from "../icons/MotionIcon.astro";

interface Props {
  href: string;
  color: string;
  icon?: string;
  image?: string;
}

const { href, color, icon, image } = Astro.props;
const external = /^https?:\/\//.test(href);
const label = (await Astro.slots.render("default")).trim();
const cut = Math.max(0, label.search(/\S+$/));
const head = label.slice(0, cut);
const last = label.slice(cut);
---

<style>
  .mark__keep {
    white-space: nowrap;
  }
  .mark__glyph {
    display: inline-flex;
    margin-left: 0.25rem;
    padding: 2px;
    vertical-align: text-bottom;
  }
  @media (hover: hover) {
    .mark:hover .mark__text {
      text-decoration: underline;
      text-decoration-thickness: from-font;
      text-underline-position: from-font;
    }
  }
</style>

<a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} class="mark font-semibold no-underline" style={`color:${color}`} data-mark
  ><span class="mark__text"><Fragment set:html={head} /><span class="mark__keep"><Fragment set:html={last} />{
    icon && (
      <span class="mark__glyph" aria-hidden="true">
        <MotionIcon name={icon} size={16} />
      </span>
    )
  }{
    image && (
      <span class="mark__glyph" aria-hidden="true" data-glyph="coin">
        <img src={image} alt="" width="16" height="16" class="size-4 object-contain" />
      </span>
    )
  }</span></span></a
>

<script>
  import { playOnArrival, playOnHover } from "../../scripts/glyph-play";

  const glyphs: HTMLElement[] = [];
  for (const mark of document.querySelectorAll<HTMLElement>("[data-mark]")) {
    const glyph = mark.querySelector<HTMLElement>("[data-glyph]");
    if (!glyph) continue;
    playOnHover(mark, glyph);
    glyphs.push(glyph);
  }
  playOnArrival(glyphs);
</script>
