---
/**
 * Inline accent chip from Figma /me (mark/*): semibold accent word(s) with a
 * 16px glyph in a padded slot. Links to the v2 reference. The link is a
 * plain inline run, so long titles (DNID) break mid-sentence like the rest of
 * the paragraph; the last word and glyph stay together so the glyph never
 * starts a line on its own.
 */
import Icon from "../icons/Icon.astro";

interface Props {
  href: string;
  color: string;
  icon?: string;
  image?: string;
}

const { href, color, icon, image } = Astro.props;
const label = (await Astro.slots.render("default")).trim();
const cut = Math.max(0, label.search(/\S+$/));
const head = label.slice(0, cut);
const last = label.slice(cut);
---

<style>
  .mark__keep {
    white-space: nowrap;
  }
  .mark__glyph {
    display: inline-flex;
    margin-left: 0.25rem;
    padding: 2px;
    vertical-align: text-bottom;
  }
  @media (hover: hover) {
    .mark:hover .mark__text {
      text-decoration: underline;
      text-decoration-thickness: from-font;
      text-underline-position: from-font;
    }
  }
</style>

<a href={href} target="_blank" rel="noopener noreferrer" class="mark font-semibold no-underline" style={`color:${color}`}
  ><span class="mark__text"><Fragment set:html={head} /><span class="mark__keep"><Fragment set:html={last} />{
    icon && (
      <span class="mark__glyph" aria-hidden="true">
        <Icon name={icon} size={16} />
      </span>
    )
  }{
    image && (
      <span class="mark__glyph" aria-hidden="true">
        <img src={image} alt="" width="16" height="16" class="size-4 object-contain" />
      </span>
    )
  }</span></span></a
>
