---
/**
 * Figma IconButton (5:193): 36px hit, 24px glyph @ 80% opacity.
 * Hover: hit fills surface/skeleton, glyph 100%, tooltip below (top 40px).
 */
import Icon from "../icons/Icon.astro";

interface Props {
  icon?: string;
  label: string;
  href?: string;
  external?: boolean;
  /** data-* hook for scripts (e.g. data-theme-toggle) */
  action?: "theme" | "motion";
  class?: string;
  /** Extra attributes for the hit element (e.g. popovertarget) */
  attrs?: Record<string, string>;
}

const { icon, label, href, external, action, class: className, attrs = {} } = Astro.props;
const actionAttrs =
  action === "theme"
    ? { "data-theme-toggle": "" }
    : action === "motion"
      ? { "data-motion-toggle": "" }
      : {};
const Tag: any = href ? "a" : "button";
const linkAttrs = href
  ? { href, ...(external ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
  : { type: "button" };
---

<div class:list={["icon-button relative flex shrink-0 flex-col items-center gap-[6px]", className]}>
  <Tag
    class="icon-button__hit squishy flex size-9 items-center justify-center overflow-clip rounded-[18px] text-fg"
    aria-label={label}
    {...linkAttrs}
    {...actionAttrs}
    {...attrs}
  >
    <span class="icon-button__glyph">
      {icon ? <Icon name={icon} /> : <slot name="icon" />}
    </span>
  </Tag>
  <span
    class="icon-button__tooltip pointer-events-none absolute top-10 left-[calc(50%+0.5px)] z-20 -translate-x-1/2 overflow-clip rounded-sm bg-tooltip-bg px-2 py-1 text-[13px] leading-[1.3] font-medium whitespace-nowrap text-tooltip-fg"
    aria-hidden="true"
  >
    {label && !Astro.slots.has("label") ? label : <slot name="label" />}
  </span>
</div>

<style>
  .icon-button__hit {
    transition: background-color var(--motion-fast) var(--ease-out);
  }
  .icon-button__glyph {
    display: contents;
  }
  .icon-button__glyph :global(.glyph) {
    opacity: 0.8;
    transition: opacity var(--motion-fast) var(--ease-out);
  }
  .icon-button__tooltip {
    opacity: 0;
    transition: opacity var(--motion-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .icon-button:hover .icon-button__hit {
      background-color: var(--skeleton);
    }
    .icon-button:hover .icon-button__glyph :global(.glyph) {
      opacity: 1;
    }
    .icon-button:hover .icon-button__tooltip {
      opacity: 1;
    }
  }
  .icon-button:has(:focus-visible) .icon-button__hit {
    background-color: var(--skeleton);
  }
  .icon-button:has(:focus-visible) .icon-button__tooltip {
    opacity: 1;
  }
</style>
