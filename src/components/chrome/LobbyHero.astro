---
/**
 * Lobby hero (Figma 16:175 desktop / 19:467 mobile). The finished three lines
 * are SSR'd for LCP, SEO and no-JS. scripts/typer.ts types them in once per
 * session — quick character steps with a held beat at each line break, and
 * v2 DescriptionTyper's blinking terminal cursor.
 */
import Icon from "../icons/Icon.astro";

const words = (text: string) => text.split(" ");
---

<h1 class="hero relative m-0 font-medium text-fg" data-hero>
  <span class="hero__line">
    <span class="hero__group"
      ><span data-tok>I'm</span>
      <span class="hero__unit"
        ><a href="/me" class="hero__liam-link squishy squishy-md"><span data-tok class="hero__liam">Liam</span></a><span data-tok data-join>.</span></span
      ></span
    >
  </span>
  <span class="hero__line hero__line--2">
    <span class="hero__group"
      ><span data-tok>A</span>
      <a
        href="https://www.tealhq.com/career-paths/business-systems-analyst"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__link"
        style="color:var(--accent-career)"
        >{
          words("Business Systems").map((word) => (
            <>
              <span data-tok class="hero__strong">{word}</span>{" "}
            </>
          ))
        }<span class="hero__keep"
          ><span data-tok class="hero__strong">Analyst</span><span class="hero__pop" data-pop="Analyst" style="--pop:var(--bsa)"
            ><span class="hero__chair"><Icon name="chart-column" class="hero__bsa" size="var(--bsa)" /></span></span
          ></span
        ></a
      ></span
    >
    <span class="hero__group"
      ><span data-tok>at</span>
      <a
        href="https://www.pnc.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hero__link"
        style="color:var(--accent-pnc)"
        ><span class="hero__keep"
          ><span data-tok class="hero__strong">PNC</span><span class="hero__pop" data-pop="PNC" style="--pop:var(--pnc)"
            ><span class="hero__ball"
              ><img src="/brand/pnc.png" alt="" width="36" height="36" class="hero__pnc block object-cover" /></span
            ></span
          ></span
        ></a
      ></span
    >
  </span>
  <span class="hero__line">
    <span class="hero__group">
      {
        words("This is my virtual museum.").map((word, index) => (
          <>
            {index > 0 && " "}
            <span data-tok>{word}</span>
          </>
        ))
      }
    </span>
  </span>
  <span class="hero__caret" aria-hidden="true" hidden>|</span>
</h1>

<style>
  /* Mobile (Figma 19:467): one wrapping run of inline text, 24/1.25 medium
     (plus the 2px row gap). Only a word and its mark are kept together. */
  .hero {
    --bsa: 22px;
    --pnc: 22px;
    --pop-gap: 6px;
    font-size: 24px;
    line-height: calc(1.25em + 2px);
  }
  .hero__unit {
    white-space: nowrap;
  }
  .hero__liam {
    color: var(--accent-walnut);
    text-decoration-line: none;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }
  .hero__unit [data-join] {
    color: var(--accent-walnut);
  }
  /* "Liam" behaves like the Me NavLink (underline on hover/press). */
  .hero__liam-link {
    color: inherit;
    text-decoration: none;
  }
  @media (hover: hover) {
    .hero__liam-link:hover .hero__liam {
      text-decoration-line: underline;
    }
  }
  .hero__liam-link:focus-visible .hero__liam,
  .hero__liam-link:active .hero__liam {
    text-decoration-line: underline;
  }
  /* Role and company link out like their /me Marks, and each mark is part of
     its link. text-decoration never underlines images, so the underline is a
     background stripe across the link's inline box (text, gap and mark),
     drawn where Geist's own underline sits: 0.1em under the baseline, 0.05em
     thick, i.e. 0.07em above the 0.22em descent. Inline boxes wrap, so the
     stripe follows "Business Systems Analyst" onto a second line on phones. */
  .hero__link {
    text-decoration: none;
    background: no-repeat linear-gradient(currentColor, currentColor) 0 calc(100% - 0.07em) / 0 max(1px, 0.05em);
  }
  @media (hover: hover) {
    .hero__link:hover {
      background-size: 100% max(1px, 0.05em);
    }
  }
  .hero__link:focus-visible,
  .hero__link:active {
    background-size: 100% max(1px, 0.05em);
  }
  :global(html.typing) .hero__link {
    background-image: none;
  }
  .hero__keep {
    white-space: nowrap;
  }
  /* Marks sit centered on the text (Geist's content box is 0.92em up / 0.22em
     down, so its middle is 0.35em above the baseline), the way the old flex
     row centered them. */
  .hero__pop {
    display: inline-block;
    margin-left: var(--pop-gap);
    vertical-align: calc(0.35em - var(--pop) / 2);
    line-height: 0;
  }
  .hero__pnc {
    width: var(--pnc);
    height: var(--pnc);
  }

  /* Desktop (Figma 16:175): three lines, 40/1.2; line 2 is a 12px-gap row. */
  @media (min-width: 768px) {
    .hero {
      --bsa: calc(28 * var(--lobby-u, 1px));
      --pnc: calc(36 * var(--lobby-u, 1px));
      --pop-gap: calc(12 * var(--lobby-u, 1px));
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      font-size: calc(40 * var(--lobby-u, 1px));
      line-height: 1.2;
    }
    .hero__line {
      display: block;
      white-space: nowrap;
    }
    .hero__line--2 {
      display: flex;
      align-items: center;
      gap: calc(12 * var(--lobby-u, 1px));
    }
    .hero__group {
      display: inline;
    }
    .hero__strong,
    .hero__liam {
      font-weight: 600;
    }
    .hero__unit [data-join] {
      color: inherit;
    }
  }

  /* Type-in state (set before paint by the lobby head script).
     Words stay in flow so the line boxes don't grow. Character spans are
     created in script, so their reveal rule is global — scoped styles
     would not match them. */
  :global(html.typing) [data-hero] [data-tok]:not([data-shown]),
  :global(html.typing) [data-hero] [data-pop]:not([data-shown]) {
    visibility: hidden;
  }
  :global(html.typing [data-hero] [data-ch][data-shown]) {
    visibility: visible;
  }
  [data-pop][data-shown] {
    animation: hero-pop var(--motion-medium) var(--ease-out) both;
  }
  @keyframes hero-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  :global(html:not(.typing)) [data-pop][data-shown] {
    animation: none;
  }

  .hero__ball,
  .hero__chair {
    display: block;
  }

  /* v2 DescriptionTyper cursor: an inline pipe that hard-blinks. It sits in
     the line (baseline, wraps with the word) but the negative margin keeps
     the reserved SSR layout from shifting. #bbb matches v2 on the dark
     field; darkened so the pipe still reads on paper. */
  .hero__caret {
    position: relative;
    z-index: 1;
    display: inline-block;
    width: 1ch;
    margin-right: -1ch;
    padding: 0;
    color: #5a5a5a;
    font-weight: 400;
    line-height: 1;
    vertical-align: baseline;
    text-align: left;
    pointer-events: none;
    user-select: none;
    animation: caret-blink 0.75s step-end infinite;
  }
  :global(html.typing) [data-hero] .hero__caret {
    visibility: visible;
  }
  :global(html.dark) .hero__caret {
    color: #bbb;
  }
  @keyframes caret-blink {
    from,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>
