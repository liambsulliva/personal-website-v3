---
/**
 * Gallery section label (Design/Writing): heading/card 24/1.2 bold.
 * `eyebrow`: small Geist label in the section accent (Featured!), matching the
 * write-up SectionHeading eyebrow (12px bold). It sits 8px above its card
 * (-4px against the section's 12px gap); headings keep the full 12px.
 */
interface Props {
  id?: string;
  eyebrow?: boolean;
}
const { id, eyebrow = false } = Astro.props;
---

<h2
  id={id}
  class:list={[
    "m-0 whitespace-nowrap",
    eyebrow
      ? "-mb-1 text-[12px] leading-[1.3] font-bold text-wing"
      : "text-[24px] leading-[1.2] font-bold text-fg",
  ]}
><slot /></h2>
