---
/** Figma TimelineRow (35:370) / TimelineRow/Mobile (37:1341). Ghost highlight on hover. */
import { cldUrl } from "../../lib/cloudinary";

interface Props {
  company: string;
  role: string;
  dates: string;
  href: string;
  monogram?: string;
  logo?: string;
  whiteLogoOnDark?: boolean;
}

const { company, role, dates, href, monogram, logo, whiteLogoOnDark = false } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="timeline-row relative isolate -mx-3 -my-2 flex w-[calc(100%+24px)] items-start gap-3 rounded-card px-3 py-2 no-underline md:items-center md:gap-4"
  data-name="TimelineRow"
  aria-label={`${company} (opens in a new tab)`}
>
  <div
    class:list={[
      "flex size-12 shrink-0 items-center justify-center overflow-clip rounded-card md:size-14",
      { "bg-surface": !logo },
    ]}
    data-name="logo"
  >
    {
      logo ? (
        <img
          src={cldUrl(logo, { width: 112 })}
          srcset={`${cldUrl(logo, { width: 56 })} 1x, ${cldUrl(logo, { width: 112 })} 2x, ${cldUrl(logo, { width: 168 })} 3x`}
          alt=""
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
          class:list={["size-full object-contain", { "timeline-row__logo--white": whiteLogoOnDark }]}
        />
      ) : (
        <span class="text-[20px] leading-none font-semibold whitespace-nowrap text-fg" aria-hidden="true">{monogram}</span>
      )
    }
  </div>
  <div class="flex min-w-px flex-[1_0_0] flex-col items-start gap-[2px] overflow-clip leading-[1.3]" data-name="text">
    <p class="m-0 text-[20px] font-semibold text-fg">{company}</p>
    <p class="m-0 text-[18px] text-muted">{role}</p>
    <p class="m-0 text-[15px] text-muted md:hidden">{dates}</p>
  </div>
  <p class="m-0 hidden text-right text-[18px] leading-[1.3] whitespace-nowrap text-muted md:block">{dates}</p>
</a>

<style>
  /* Ghost highlight: a faint rounded tint that fades in on hover. It's an
     opacity fade on a pseudo-element rather than a background-color
     transition, since Safari doesn't animate color-mix() backgrounds over
     the @property-registered theme colors (it snaps or skips the tint). */
  .timeline-row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--fg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .timeline-row:hover::before {
      opacity: 0.05;
    }
  }
  .timeline-row:focus-visible::before {
    opacity: 0.05;
  }
  :global(html.dark) .timeline-row__logo--white {
    filter: brightness(0) invert(1);
  }
</style>
