---
/** Figma TimelineRow (35:370) / TimelineRow/Mobile (37:1341). No hover. */
import { cldUrl } from "../../lib/cloudinary";

interface Props {
  company: string;
  role: string;
  dates: string;
  href: string;
  monogram?: string;
  logo?: string;
}

const { company, role, dates, href, monogram, logo } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="timeline-row squishy squishy-tile -mx-3 -my-2 flex w-[calc(100%+24px)] items-start gap-3 rounded-card px-3 py-2 no-underline md:items-center md:gap-4"
  data-name="TimelineRow"
  aria-label={`${company} (opens in a new tab)`}
>
  <div
    class:list={[
      "flex size-12 shrink-0 items-center justify-center overflow-clip rounded-card md:size-14",
      { "bg-surface": !logo },
    ]}
    data-name="logo"
  >
    {
      logo ? (
        <img
          src={cldUrl(logo, { width: 112 })}
          srcset={`${cldUrl(logo, { width: 56 })} 1x, ${cldUrl(logo, { width: 112 })} 2x, ${cldUrl(logo, { width: 168 })} 3x`}
          alt=""
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
          class="size-full object-contain"
        />
      ) : (
        <span class="text-[20px] leading-none font-semibold whitespace-nowrap text-fg" aria-hidden="true">{monogram}</span>
      )
    }
  </div>
  <div class="flex min-w-px flex-[1_0_0] flex-col items-start gap-[2px] overflow-clip leading-[1.3]" data-name="text">
    <p class="m-0 text-[20px] font-semibold text-fg">{company}</p>
    <p class="m-0 text-[18px] text-muted">{role}</p>
    <p class="m-0 text-[15px] text-muted md:hidden">{dates}</p>
  </div>
  <p class="m-0 hidden text-right text-[18px] leading-[1.3] whitespace-nowrap text-muted md:block">{dates}</p>
</a>

<style>
  /* Ghost highlight: no borders, a faint rounded rectangle on hover. */
  .timeline-row {
    transition:
      background-color var(--motion-fast) var(--ease-out),
      transform 460ms cubic-bezier(0.34, 2.1, 0.5, 1);
  }
  @media (hover: hover) {
    .timeline-row:hover {
      background-color: color-mix(in srgb, var(--fg) 5%, transparent);
    }
  }
</style>
