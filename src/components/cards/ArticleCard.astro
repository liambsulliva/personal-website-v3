---
/**
 * Figma ArticleCard (14:183): 192px media, title + external icon, meta.
 * `wide` media trades the 192px strip for a full-width 16:9 crop (Layouts),
 * so more of each page's height shows.
 */
import CldImage from "../media/CldImage.astro";
import Icon from "../icons/Icon.astro";

interface Props {
  title: string;
  meta: string;
  href: string;
  /** Cloudinary public_id */
  image?: string;
  /** Third-party feed image (e.g. WordPress), already sized */
  imageUrl?: string;
  external?: boolean;
  media?: "strip" | "wide";
}

const { title, meta, href, image, imageUrl, external = true, media = "strip" } = Astro.props;
const wide = media === "wide";
---

<a
  href={href}
  class="article-card hover-surface flex w-full min-w-0 flex-col items-start overflow-clip rounded-card border border-border bg-surface no-underline"
  style="--hover-base:var(--surface)"
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div class:list={["relative w-full shrink-0 bg-skeleton", wide ? "aspect-video" : "h-[192px]"]} data-name="media">
    {image && <CldImage id={image} alt="" aspect="16:9" fill sizes="(min-width: 1024px) 660px, 100vw" />}
    {!image && imageUrl && <img src={imageUrl} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />}
  </div>
  <div class="flex w-full flex-col items-start gap-0.5 overflow-clip p-5" data-name="content">
    <div class="flex w-full items-center gap-2 overflow-clip" data-name="title-row">
      <p class="m-0 min-w-px flex-[1_0_0] truncate text-[16px] leading-[1.3] font-medium text-fg">{title}</p>
      {external && <Icon name="external-link" size={16} class="text-fg" />}
    </div>
    <p class="m-0 text-[16px] leading-[1.3] whitespace-nowrap text-muted">{meta}</p>
  </div>
</a>
