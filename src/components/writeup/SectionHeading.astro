---
/**
 * Figma SectionHeading (50:377): wing-accent eyebrow (12px bold Geist, as
 * written: no caps or tracking) 4px above a 36px h2 (tracking -1.26px). Only
 * write-ups use this; gallery eyebrows are SectionLabel. TOC entries
 * are generated from these (label = toc ?? eyebrow ?? title).
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  toc?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<header class="section-heading flex w-full flex-col items-start gap-1">
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2 id={id} class="section-heading__title">{title}</h2>
</header>
