---
interface Props {
  features: { title: string; description: string }[];
}
const { features } = Astro.props;
---

<div class="grid w-full gap-3 sm:grid-cols-2">
  {
    features.map((feature) => (
      <article class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-3 rounded-card border border-border bg-card p-4">
        <span class="flex size-6 items-center justify-center rounded-sm bg-wing text-[13px] font-bold text-bg" aria-hidden="true">
          ✓
        </span>
        <div class="flex flex-col gap-1">
          <h4 class="m-0 text-[16px] leading-[1.3] font-semibold text-fg">{feature.title}</h4>
          <p class="writeup-small m-0" set:html={feature.description} />
        </div>
      </article>
    ))
  }
</div>
