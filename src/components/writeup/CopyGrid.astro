---
interface Props {
  items: { label: string; body: string }[];
  columns?: 2 | 3;
}
const { items, columns = 3 } = Astro.props;
---

<div class:list={["grid w-full gap-6", columns === 2 ? "md:grid-cols-2" : "md:grid-cols-3"]}>
  {
    items.map((item) => (
      <p class="writeup-small m-0">
        <strong class="mb-1 block text-[16px] leading-[1.3] font-semibold text-fg">{item.label}</strong>
        {item.body}
      </p>
    ))
  }
</div>
