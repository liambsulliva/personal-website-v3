---
import Img from "./Img.astro";

interface Props {
  title: string;
  image: string;
  imageAlt: string;
  pros: string[];
  cons: string[];
}
const { title, image, imageAlt, pros, cons } = Astro.props;
const rows = [
  ...pros.map((text) => ({ text, pro: true })),
  ...cons.map((text) => ({ text, pro: false })),
];
---

<article class="flex h-full w-full min-w-0 flex-col gap-4 rounded-card border border-border bg-card p-6">
  <Img id={image} alt={imageAlt} sizes="(min-width: 768px) 360px, 100vw" class="rounded-md" />
  <h3 class="m-0 text-[24px] leading-[1.2] font-bold text-fg">{title}</h3>
  <div class="flex flex-col gap-3">
    {
      rows.map((row) => (
        <div class="grid grid-cols-[22px_minmax(0,1fr)] items-start gap-3">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-label={row.pro ? "Pro" : "Con"} style={`color:${row.pro ? "var(--accent-engineering)" : "var(--accent-writing)"}`}>
            <path
              fill="currentColor"
              d={
                row.pro
                  ? "M23 10a2 2 0 0 0-2-2h-6.32l.96-4.57c.02-.1.03-.21.03-.32c0-.41-.17-.79-.44-1.06L14.17 1L7.59 7.58C7.22 7.95 7 8.45 7 9v10a2 2 0 0 0 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73zM1 21h4V9H1z"
                  : "M19 15h4V3h-4m-4 0H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2a2 2 0 0 0 2 2h6.31l-.95 4.57c-.02.1-.03.2-.03.31c0 .42.17.79.44 1.06L9.83 23l6.58-6.59c.37-.36.59-.86.59-1.41V5a2 2 0 0 0-2-2"
              }
            />
          </svg>
          <p class="writeup-small m-0">{row.text}</p>
        </div>
      ))
    }
  </div>
</article>
