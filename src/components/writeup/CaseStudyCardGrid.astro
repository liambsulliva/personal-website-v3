---
/**
 * Grid of CaseStudyCards, gap 12. Workshop-grid is 3 up. The 5-card wiki-grid
 * is 3 over 2 (bottom pair stretched) on a 6-track grid, 2 × 2 + 1 at sm, and
 * a single column on phones.
 */
interface Props {
  columns?: 1 | 2 | 3 | 5;
}
const { columns = 3 } = Astro.props;
const cols = {
  1: "grid-cols-1",
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-3",
  5: "items-stretch grid-cols-1 sm:grid-cols-2 sm:[&>:last-child]:col-span-2 md:grid-cols-6 md:[&>*]:col-span-2 md:[&>:nth-child(n+4)]:col-span-3",
}[columns];
---

<div class:list={["case-study-grid grid w-full min-w-0 gap-3", columns === 5 ? "" : "items-start", cols]} data-columns={columns}>
  <slot />
</div>
