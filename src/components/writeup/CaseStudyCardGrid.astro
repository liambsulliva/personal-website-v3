---
/** Grid of CaseStudyCards. Figma wiki-grid (5 up) / workshop-grid (3 up), gap 12. */
interface Props {
  columns?: 1 | 2 | 3 | 5;
}
const { columns = 3 } = Astro.props;
const cols = {
  1: "grid-cols-1",
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-3",
  5: "grid-cols-2 sm:grid-cols-3 lg:grid-cols-5",
}[columns];
---

<div class:list={["case-study-grid grid w-full min-w-0 items-start gap-3", cols]} data-columns={columns}>
  <slot />
</div>
