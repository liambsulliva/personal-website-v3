---
/**
 * Scrollable screenshot inside a phone frame (both from Cloudinary).
 * The screen is sized with % + contain (not translate-centered): iOS WebKit
 * lets a tall overflow-y child of top/left 50% + translate(-50%, -50%) grow
 * and paint to the viewport top, so the frame no longer covers it.
 */
import { cldSrcSet, cldUrl, assetRatio } from "../../lib/cloudinary";

interface Props {
  content: string;
  frame: string;
  alt?: string;
}
const { content, frame, alt = "Mobile view" } = Astro.props;
---

<div class="phone-mockup relative mx-auto aspect-[9/16] w-full max-w-[260px] overflow-hidden">
  <div class="phone-mockup__screen overflow-x-hidden overflow-y-auto overscroll-contain bg-skeleton" tabindex="0" aria-label="Scrollable screenshot">
    <img
      src={cldUrl(content, { width: 540 })}
      srcset={cldSrcSet(content, {}, [270, 540, 810])}
      sizes="240px"
      alt={alt}
      loading="lazy"
      decoding="async"
      class="block h-auto w-full max-w-full"
      style={`aspect-ratio:${assetRatio(content, "9 / 40")}`}
    />
  </div>
  <img
    src={cldUrl(frame, { width: 520 })}
    srcset={cldSrcSet(frame, {}, [260, 520, 780])}
    sizes="260px"
    alt=""
    loading="lazy"
    decoding="async"
    class="pointer-events-none absolute inset-0 z-[2] h-full w-full object-contain"
  />
  <span class="absolute top-4 right-0 z-30 flex h-10 items-center gap-1 rounded-md border border-border bg-bg px-3 text-[13px] leading-[1.3] font-medium text-fg">
    Scroll me!
  </span>
</div>

<style>
  .phone-mockup {
    isolation: isolate;
  }
  .phone-mockup__screen {
    position: absolute;
    top: 5%;
    left: 5%;
    z-index: 1;
    width: 90%;
    height: 90%;
    border-radius: 28px;
    contain: strict;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .phone-mockup__screen::-webkit-scrollbar {
    display: none;
  }
</style>
