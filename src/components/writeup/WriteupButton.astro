---
/** Figma WriteupButton (50:398): Primary = Live Demo, Secondary = GitHub. */
import Icon from "../icons/Icon.astro";

interface Props {
  href: string;
  variant: "primary" | "secondary";
  label: string;
}
const { href, variant, label } = Astro.props;
const primary = variant === "primary";
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["writeup-button squishy squishy-md flex shrink-0 items-center gap-2 rounded-pill border px-4 py-2 no-underline", primary ? "writeup-button--primary" : "writeup-button--secondary"]}
>
  <Icon name={primary ? "external-link" : "github"} />
  <span class="text-[15px] leading-[1.2] font-semibold whitespace-nowrap">{label}</span>
</a>

<style>
  .writeup-button {
    border-color: var(--button-border);
    transition: background-color var(--motion-fast) var(--ease-out);
  }
  .writeup-button--primary {
    background: var(--button-primary-bg);
    color: var(--button-primary-fg);
  }
  .writeup-button--secondary {
    background: var(--button-secondary-bg);
    color: var(--button-secondary-fg);
  }
  @media (hover: hover) {
    .writeup-button--primary:hover {
      background: color-mix(in srgb, var(--button-primary-bg) 90%, #000);
    }
    .writeup-button--secondary:hover {
      background: color-mix(in srgb, var(--button-secondary-bg) 88%, #fff);
    }
  }
</style>
