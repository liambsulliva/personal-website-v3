---
import "../styles/global.css";
import ReducedMotion from "../components/chrome/ReducedMotion.astro";

interface Props {
  title?: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  "Developer, designer, photographer, and a few other things picked up along the way.";

const { title = "Liam Sullivan", description = DEFAULT_DESCRIPTION } =
  Astro.props;
// Canonical and share URLs are absolute; without `site`, fall back to the request origin.
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL("/banner.jpg", origin);
// Favicons follow the browser's color scheme (its tab strip), not the site theme.
const FAVICON_SCHEMES = ["light", "dark"] as const;
const FAVICON_SIZES = [16, 32, 64, 128, 256, 512];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Liam Sullivan" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {FAVICON_SCHEMES.map((scheme) => (
      <>
        {FAVICON_SIZES.map((size) => (
          <link
            rel="icon"
            type="image/png"
            sizes={`${size}x${size}`}
            href={`/favicon/icon-${scheme}-${size}.png`}
            media={`(prefers-color-scheme: ${scheme})`}
          />
        ))}
        <link
          rel="icon"
          type="image/svg+xml"
          href={`/favicon/icon-${scheme}.svg`}
          media={`(prefers-color-scheme: ${scheme})`}
        />
      </>
    ))}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme + motion before first paint (no FOUC). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let theme = "light";
        let motion = null;
        try {
          theme = localStorage.getItem("theme") || "light";
          motion = localStorage.getItem("motion");
        } catch {}
        const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = theme;
        root.classList.toggle(
          "dark",
          theme === "dark" || (theme === "system" && systemDark),
        );
        const reduced = motion
          ? motion === "reduced"
          : matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) root.setAttribute("data-reduced-motion", "");
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-sm bg-fg px-3 py-2 text-[14px] font-medium text-bg no-underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <ReducedMotion />
    <slot />
    <script>
      import "../scripts/controls";
    </script>
  </body>
</html>
