---
import "../styles/global.css";
import ReducedMotion from "../components/chrome/ReducedMotion.astro";
import geist400 from "@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url";
import geist500 from "@fontsource/geist-sans/files/geist-sans-latin-500-normal.woff2?url";
import geist600 from "@fontsource/geist-sans/files/geist-sans-latin-600-normal.woff2?url";
import geist700 from "@fontsource/geist-sans/files/geist-sans-latin-700-normal.woff2?url";
import martianLatin from "@fontsource-variable/martian-mono/files/martian-mono-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  "Developer, designer, photographer, and a few other things picked up along the way.";

const { title = "Liam Sullivan", description = DEFAULT_DESCRIPTION } =
  Astro.props;
// Canonical and share URLs are absolute; without `site`, fall back to the request origin.
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL("/banner.jpg", origin);
// Favicons follow the browser's color scheme (its tab strip), not the site theme.
const FAVICON_SCHEMES = ["light", "dark"] as const;
const FAVICON_SIZES = [16, 32, 64, 128, 256, 512];
// global.css declares every face too, but integrations/criticalCss.mjs
// defers it at print priority, so first paint would use fallback metrics and
// reflow when it lands. These are declared up front; the three Geist weights
// every page sets above the fold are also preloaded.
const geist = (weight: number, href: string) =>
  `@font-face{font-family:"Geist Sans";font-style:normal;font-display:swap;font-weight:${weight};src:url(${href}) format("woff2")}`;
const CRITICAL_FONTS = [geist400, geist500, geist600];
const criticalFontFaces = [
  geist(400, geist400),
  geist(500, geist500),
  geist(600, geist600),
  geist(700, geist700),
  // @fontsource-variable/martian-mono latin subset.
  `@font-face{font-family:"Martian Mono Variable";font-style:normal;font-display:swap;font-weight:100 800;src:url(${martianLatin}) format("woff2-variations");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`,
].join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Liam Sullivan" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {CRITICAL_FONTS.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <style is:inline set:html={criticalFontFaces} />
    {FAVICON_SCHEMES.map((scheme) => (
      <>
        {FAVICON_SIZES.map((size) => (
          <link
            rel="icon"
            type="image/png"
            sizes={`${size}x${size}`}
            href={`/favicon/icon-${scheme}-${size}.png`}
            media={`(prefers-color-scheme: ${scheme})`}
          />
        ))}
        <link
          rel="icon"
          type="image/svg+xml"
          href={`/favicon/icon-${scheme}.svg`}
          media={`(prefers-color-scheme: ${scheme})`}
        />
      </>
    ))}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme + motion before first paint (no FOUC). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        // System until the visitor picks a theme; only an explicit pick is stored.
        let theme = "system";
        let motion = null;
        try {
          theme = localStorage.getItem("theme") || "system";
          motion = localStorage.getItem("motion");
        } catch {}
        const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = theme;
        root.classList.toggle(
          "dark",
          theme === "dark" || (theme === "system" && systemDark),
        );
        const reduced = motion
          ? motion === "reduced"
          : matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) root.setAttribute("data-reduced-motion", "");
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-sm bg-fg px-3 py-2 text-[14px] font-medium text-bg no-underline focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <ReducedMotion />
    <slot />
    <script>
      import "../scripts/controls";
    </script>
  </body>
</html>
