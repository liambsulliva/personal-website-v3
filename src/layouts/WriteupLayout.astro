---
/**
 * Figma Subpage / Write-up (51:1374). Header title in the wing accent,
 * subtitle, 900px hero (named slot for islands), tool badges + GitHub/Demo
 * WriteupButtons, Role/Team/Timeline row, then a 760px article with a sticky
 * Contents column generated from the MDX SectionHeadings.
 */
import "../styles/writeup.css";
import SubpageLayout from "./SubpageLayout.astro";
import Badge from "../components/cards/Badge.astro";
import WriteupButton from "../components/writeup/WriteupButton.astro";
import CldImage from "../components/media/CldImage.astro";
import { sectionByKey } from "../lib/sections";
import type { TocItem } from "../lib/toc";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
  toc: TocItem[];
  /** The route fills the "hero" slot with an island (Book, Switch HUD). */
  islandHero?: boolean;
}

const { entry, toc, islandHero = false } = Astro.props;
const { data } = entry;
const wing = sectionByKey(data.wing);
const meta = [
  { label: "Role", items: data.role },
  { label: "Team", items: data.team },
  { label: "Timeline", items: data.timeline },
].filter((column) => column.items && column.items.length > 0);
const hasButtons = Boolean(data.github || data.demo);

---

<SubpageLayout
  title={`${data.title} - Liam Sullivan`}
  description={data.description}
  section={data.wing}
  back={{ href: `/${data.wing}`, label: wing.label }}
  heading={data.title}
  subheading={data.subtitle}
>
  <div class="writeup flex w-full flex-col items-center gap-8 px-6 pt-8 pb-16 md:px-16" style={`--wing:${wing.color}`}>
    <div class="w-full max-w-[900px]" data-name="hero">
      {
        islandHero ? (
          <slot name="hero" />
        ) : (
          <CldImage
            id={data.hero ?? data.image}
            alt={data.title}
            aspect="15:7"
            sizes="(min-width: 1028px) 900px, 100vw"
            loading="eager"
            fetchpriority="high"
            bare={data.heroFit === "contain"}
            class="rounded-card"
          />
        )
      }
    </div>

    {
      (data.tools?.length || hasButtons) && (
        <div class="flex w-full max-w-[900px] flex-col items-start gap-4 md:flex-row md:items-center md:justify-between" data-name="tools-and-buttons">
          <div class="flex flex-wrap items-start gap-2" data-name="badges">
            {data.tools?.map((tool) => <Badge label={tool} />)}
          </div>
          {hasButtons && (
            <div class="flex shrink-0 items-center gap-4" data-name="buttons">
              {data.github && <WriteupButton href={data.github} variant="secondary" label="GitHub" />}
              {data.demo && <WriteupButton href={data.demo} variant="primary" label="Live Demo" />}
            </div>
          )}
        </div>
      )
    }

    {
      meta.length > 0 && (
        <dl class="m-0 flex w-full max-w-[900px] flex-col items-stretch gap-4 pt-4 sm:flex-row sm:items-center" data-name="project-info">
          {meta.map((column, index) => (
            <>
              {index > 0 && <span class="h-px w-full shrink-0 bg-border sm:h-14 sm:w-px" aria-hidden="true" />}
              <div class="flex min-w-px flex-[1_0_0] flex-col items-center gap-2 overflow-clip text-center text-[16px]">
                <dt class="leading-[1.3] font-semibold text-fg">{column.label}</dt>
                {column.items!.map((item) => (
                  <dd class="m-0 leading-[1.4] text-muted">{item}</dd>
                ))}
              </div>
            </>
          ))}
        </dl>
      )
    }

    <div class="flex w-full max-w-[980px] items-start gap-[52px]" data-name="Body">
      <article class="writeup-article w-full max-w-[760px] min-w-0 flex-1" data-name="Article">
        <slot />
      </article>
      {
        toc.length > 0 && (
          <nav class="sticky top-8 hidden w-[168px] shrink-0 flex-col items-start gap-[10px] lg:flex" aria-label="Contents" data-toc>
            <p class="m-0 text-[13px] leading-[1.3] font-bold text-muted">CONTENTS</p>
            {toc.map((item) => (
              <a href={`#${item.id}`} class="toc-link text-[14px] leading-[1.4] whitespace-nowrap text-muted no-underline" data-toc-link={item.id}>
                {item.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>
</SubpageLayout>

<style>
  .toc-link {
    transition: color var(--motion-fast) var(--ease-out);
  }
  .toc-link[aria-current="true"] {
    color: var(--wing);
  }
  @media (hover: hover) {
    .toc-link:hover {
      color: var(--fg);
    }
    .toc-link[aria-current="true"]:hover {
      color: var(--wing);
    }
  }
</style>

<script>
  // Active TOC heading: the last h2 whose top has crossed 30% of the viewport.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink!))
      .filter((heading): heading is HTMLElement => Boolean(heading));

    const update = () => {
      const line = window.innerHeight * 0.3;
      let active = headings[0]?.id;
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= line) active = heading.id;
      }
      links.forEach((link) =>
        link.setAttribute("aria-current", String(link.dataset.tocLink === active)),
      );
    };

    let frame = 0;
    window.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();

    // Contents clicks glide to the section (eased, distance-scaled, ~0.7–1.6s).
    // Wheel/touch/keys cancel the glide; zap jumps instantly.
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    let glide = 0;
    const cancelGlide = () => cancelAnimationFrame(glide);
    ["wheel", "touchstart", "keydown"].forEach((type) =>
      window.addEventListener(type, cancelGlide, { passive: true }),
    );

    links.forEach((link) =>
      link.addEventListener("click", (event) => {
        const target = document.getElementById(link.dataset.tocLink!);
        if (!target) return;
        event.preventDefault();
        history.replaceState(null, "", `#${target.id}`);

        const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        const to = window.scrollY + target.getBoundingClientRect().top - offset;
        if (document.documentElement.hasAttribute("data-reduced-motion")) {
          window.scrollTo(0, to);
          return;
        }

        const from = window.scrollY;
        const distance = to - from;
        const duration = Math.min(1600, Math.max(700, Math.abs(distance) * 0.35));
        const start = performance.now();
        cancelGlide();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          window.scrollTo(0, from + distance * ease(t));
          if (t < 1) glide = requestAnimationFrame(step);
        };
        glide = requestAnimationFrame(step);
      }),
    );
  }
</script>
