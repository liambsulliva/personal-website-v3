---
/** Shared chrome for every public subpage: SubpageHeader, PageTitle + slot in <main>, SubpageFooter. */
import RootLayout from "./RootLayout.astro";
import SubpageHeader from "../components/chrome/SubpageHeader.astro";
import PageTitle from "../components/chrome/PageTitle.astro";
import SubpageFooter from "../components/chrome/SubpageFooter.astro";
import { sectionByKey, type SectionKey } from "../lib/sections";

interface Props {
  title: string;
  description?: string;
  section?: SectionKey;
  /** Header title override (write-ups) */
  heading?: string;
  headingColor?: string;
  showHeading?: boolean;
  subheading?: string;
  back?: { href: string; label: string };
}

const { title, description, section, heading, headingColor, showHeading, subheading, back } = Astro.props;
// The Me variant omits the title row; so do pages with nothing to title.
const titled = (showHeading ?? section !== "me") && Boolean(heading ?? section);
// Section accent for in-page labels (SectionLabel eyebrow); write-ups set their own.
const wing = section ? sectionByKey(section).color : undefined;
---

<RootLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <div class="flex min-h-dvh flex-col">
    <SubpageHeader section={section} titled={titled} />
    <!-- Content is clamped to the /me row (400 + 64 + 680 + 2 × 64 gutters); chrome stays full-bleed. -->
    <main id="main" tabindex="-1" class="mx-auto flex w-full max-w-[1272px] flex-[1_0_auto] flex-col outline-none" style={wing && `--wing:${wing}`}>
      {titled && <PageTitle section={section} title={heading} color={headingColor} subtitle={subheading} back={back} />}
      <slot />
    </main>
    <SubpageFooter />
  </div>
</RootLayout>
